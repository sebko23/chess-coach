# Test image for the FU-20 Linux network-isolation CI job.
#
# The launcher unit tests need pytest AND the repository's own conftest
# (which imports the application stack). The production image
# (`Dockerfile`) is a runtime image and carries neither, so the tests
# run in this image instead.
#
# The dependency resolution is the production image's own: the same
# `uv sync --frozen --extra dev` (the `dev` extra is what carries
# pytest) and the same editable install. The seccomp profile and the
# AppArmor profile are attached at RUN time, identically for both
# images.
FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /usr/local/bin/

WORKDIR /app

# The same layered dependency resolution as the production image.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra dev

COPY libs/ ./libs/
COPY services/ ./services/
COPY apps/ ./apps/

RUN uv pip install --system --no-cache -e .

WORKDIR /app
